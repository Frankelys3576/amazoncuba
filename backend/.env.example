PORT=5000
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Clave compartida para las rutas administrativas (usuarios, ajustes,
# aprobación de tiendas, datos de Zelle). Si no se configura, esas rutas
# rechazan TODAS las peticiones: falla cerrado a propósito.
# Genérala con: openssl rand -hex 32
# Es una medida temporal; el diseño definitivo autenticará a cada
# administrador por separado, para saber quién hizo qué.
ADMIN_API_KEY=your_admin_api_key
