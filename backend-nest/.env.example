PORT=5001

# Prisma needs two Postgres URLs on Supabase.
#
# DATABASE_URL — the POOLED (Supavisor) connection, used for queries at
# runtime. Serverless functions fan out to many concurrent instances, and
# pointing them at the direct connection exhausts Postgres' connection
# limit. Use the pooler host on port 6543 with pgbouncer=true.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL — the DIRECT connection (port 5432), used only for schema
# operations (migrate, db pull), which cannot run through the pooler.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
